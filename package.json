{
  "name": "multiyap",
  "private": true,
  "version": "1.2.0",
  "description": "Moderation und Multichat für Twitch",
  "author": "MultiYap",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:wasm": "cargo build -p multiyap-wasm --target wasm32-unknown-unknown --profile wasm && wasm-bindgen target/wasm32-unknown-unknown/wasm/multiyap_wasm.wasm --target web --weak-refs --remove-name-section --remove-producers-section --out-dir src/wasm/pkg",
    "lint": "oxlint",
    "test": "cargo test --workspace && npm run test:wasm",
    "test:wasm": "cargo test -p multiyap-web --target wasm32-unknown-unknown",
    "preview": "vite preview",
    "start": "cargo run --release -p multiyap-server --",
    "app": "tauri dev",
    "app:dist": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
